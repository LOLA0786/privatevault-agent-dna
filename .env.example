# Local development only. Production must configure PV_API_KEYS_FILE instead.
# Authentication bypass requires explicit local-development opt-in.
# Never enable this in evaluation, staging, or production.
# PV_ALLOW_NO_AUTH=1
# Path mounted into the container when authentication is enabled.
# PV_API_KEYS_FILE=/run/secrets/privatevault-api-keys.json

# Optional enforcement controls.
# PV_POLICY_FILE=/config/policy.yaml
# PV_GRANTS_FILE=/config/grants.json
# PV_RECEIPT_SIGNING_KEY=<64-character Ed25519 seed hex>
# PV_TRUSTED_PUBLIC_KEYS=<comma-separated public-key hex>
