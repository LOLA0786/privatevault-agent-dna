{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drp.privatevault.ai/schemas/execution_event.schema.json",
  "title": "ExecutionEvent",
  "description": "Executor feedback for exactly one decision. prev_hash is the record_hash of the referenced decision (anchor binding), NOT part of the agent decision chain. At most one execution event per decision. A status of ok on a decision that was block constitutes enforcement divergence and MUST fail verification.",
  "type": "object",
  "required": [
    "protocol_version",
    "kind",
    "event_id",
    "agent_id",
    "decision_ref",
    "status",
    "detail",
    "edges",
    "timestamp",
    "prev_hash",
    "record_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "drp/0.1"
    },
    "kind": {
      "const": "execution"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_ref": {
      "type": "string",
      "minLength": 1,
      "description": "decision_id of the decision this event reports on. Must appear earlier in the file."
    },
    "status": {
      "enum": [
        "ok",
        "error",
        "refused",
        "indeterminate"
      ]
    },
    "detail": {
      "type": "string"
    },
    "response_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Optional SHA-256 of the exact upstream response bytes bound to this execution. Omitted when no response was witnessed."
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "resulted_in"
            ]
          },
          "target": {
            "type": "string"
          }
        }
      },
      "description": "resulted_in edge: target = decision_ref."
    },
    "timestamp": {
      "type": "number"
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "record_hash of the referenced decision (anchor)."
    },
    "record_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}