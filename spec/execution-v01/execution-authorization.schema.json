{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privatevault.ai/spec/execution-v01/execution-authorization.schema.json",
  "title": "PrivateVault Execution Authorization v0.1-experimental",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "canonicalization",
    "execution_authorization_id",
    "organisation_id",
    "request_id",
    "issued_at",
    "not_before",
    "expires_at",
    "nonce",
    "decision_receipt_digest",
    "authority_receipt_digest",
    "approval_artifact_digest",
    "action",
    "action_digest",
    "expected_wire_bytes_digest",
    "expected_wire_bytes_length",
    "expected_peer_identity_digest",
    "dispatch",
    "state_snapshot_digest",
    "policy_bundle_digest",
    "trust_bundle_digest",
    "obligations_digest",
    "max_uses",
    "signer_key_id",
    "signature"
  ],
  "properties": {
    "spec": {
      "const": "pv-execution-authorization/0.1-experimental"
    },
    "canonicalization": {
      "const": "RFC8785"
    },
    "execution_authorization_id": {
      "type": "string",
      "minLength": 1
    },
    "organisation_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "not_before": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "decision_receipt_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "authority_receipt_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "approval_artifact_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256Digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "$ref": "#/$defs/action"
    },
    "action_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "expected_wire_bytes_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "expected_wire_bytes_length": {
      "type": "integer",
      "minimum": 0
    },
    "expected_peer_identity_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "dispatch": {
      "$ref": "#/$defs/dispatch"
    },
    "state_snapshot_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "policy_bundle_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "trust_bundle_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "obligations_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "max_uses": {
      "type": "integer",
      "const": 1
    },
    "signer_key_id": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9+/]+={0,2}$"
    }
  },
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_principal",
        "subject_key_id",
        "action",
        "resource",
        "parameters"
      ],
      "properties": {
        "subject_principal": {
          "type": "string",
          "minLength": 1
        },
        "subject_key_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "destination",
        "operation",
        "wire_content_type",
        "wire_content_encoding",
        "tool_id",
        "tool_schema_digest",
        "tool_artifact_digest",
        "credential_audience",
        "idempotency_key_digest",
        "retry_policy_digest",
        "serialization"
      ],
      "properties": {
        "transport": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "wire_content_type": {
          "type": "string",
          "minLength": 1
        },
        "wire_content_encoding": {
          "type": "string",
          "minLength": 1
        },
        "tool_id": {
          "type": "string",
          "minLength": 1
        },
        "tool_schema_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "tool_artifact_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "credential_audience": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "retry_policy_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "serialization": {
          "type": "string",
          "minLength": 1,
          "const": "pv-json-parameters/0.1"
        }
      }
    }
  }
}
