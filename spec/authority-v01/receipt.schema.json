{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privatevault.ai/spec/authority-v01/receipt.schema.json",
  "title": "PrivateVault Authority Receipt v0.1-experimental",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "canonicalization",
    "receipt_id",
    "organisation_id",
    "previous_receipt_hash",
    "request_id",
    "decision_timestamp",
    "decision_input_digest",
    "grant_chain",
    "requested",
    "authority_result",
    "policy_result",
    "composition_profile",
    "final_verdict",
    "signer_key_id",
    "signature"
  ],
  "properties": {
    "spec": {
      "const": "pv-authority-receipt/0.1-experimental"
    },
    "canonicalization": {
      "const": "RFC8785"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "organisation_id": {
      "type": "string",
      "minLength": 1
    },
    "previous_receipt_hash": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "decision_input_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "grant_chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://privatevault.ai/spec/authority-v01/grant.schema.json"
      }
    },
    "requested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_principal",
        "subject_key_id",
        "action",
        "resource",
        "facts"
      ],
      "properties": {
        "subject_principal": {
          "type": "string",
          "minLength": 1
        },
        "subject_key_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "type": "object"
        }
      }
    },
    "authority_result": {
      "$ref": "#/$defs/authorityResult"
    },
    "policy_result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/policyResult"
        }
      ]
    },
    "composition_profile": {
      "const": "pv-fail-closed/0.1"
    },
    "final_verdict": {
      "$ref": "#/$defs/verdict"
    },
    "signer_key_id": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9+/]+={0,2}$"
    }
  },
  "$defs": {
    "verdict": {
      "enum": [
        "ALLOW",
        "DENY",
        "REQUIRE_APPROVAL"
      ]
    },
    "authorityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "reason_code"
      ],
      "properties": {
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "policyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "policy_id",
        "policy_version",
        "policy_digest"
      ],
      "properties": {
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
