{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privatevault.ai/spec/authority-v01/grant.schema.json",
  "title": "PrivateVault Authority Grant v0.1-experimental",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "canonicalization",
    "grant_id",
    "organisation_id",
    "issuer_principal",
    "issuer_key_id",
    "subject_principal",
    "subject_key_id",
    "parent_grant_digest",
    "capabilities",
    "can_delegate",
    "remaining_depth",
    "valid_from",
    "expires_at",
    "issuer_signature"
  ],
  "properties": {
    "spec": {
      "const": "pv-grant/0.1-experimental"
    },
    "canonicalization": {
      "const": "RFC8785"
    },
    "grant_id": {
      "type": "string",
      "minLength": 1
    },
    "organisation_id": {
      "type": "string",
      "minLength": 1
    },
    "issuer_principal": {
      "type": "string",
      "minLength": 1
    },
    "issuer_key_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_principal": {
      "type": "string",
      "minLength": 1
    },
    "subject_key_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_grant_digest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "can_delegate": {
      "type": "boolean"
    },
    "remaining_depth": {
      "type": "integer",
      "minimum": 0
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "issuer_signature": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9+/]+={0,2}$"
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minor_units",
        "currency"
      ],
      "properties": {
        "minor_units": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "orderedValue": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "$ref": "#/$defs/money"
        }
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "operator",
        "value"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "lte",
            "gte",
            "in",
            "not_in",
            "eq"
          ]
        },
        "value": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "lte",
                  "gte"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/orderedValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "in",
                  "not_in"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        }
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "resource",
        "constraints",
        "obligations"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "string",
          "pattern": "^[^*]+(?::\\*)?$"
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          }
        },
        "obligations": {
          "type": "array",
          "uniqueItems": true
        }
      }
    }
  }
}
