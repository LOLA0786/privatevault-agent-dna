{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privatevault.ai/spec/authority-v01/trust-bundle.schema.json",
  "title": "PrivateVault Authority Trust Bundle v0.1-experimental",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "canonicalization",
    "organisation_id",
    "bundle_version",
    "pinned_at",
    "keys"
  ],
  "properties": {
    "spec": {
      "const": "pv-trust-bundle/0.1-experimental"
    },
    "canonicalization": {
      "const": "RFC8785"
    },
    "organisation_id": {
      "type": "string",
      "minLength": 1
    },
    "bundle_version": {
      "type": "integer",
      "minimum": 1
    },
    "pinned_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "principal",
          "algorithm",
          "public_key",
          "usages"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "minLength": 1
          },
          "principal": {
            "type": "string",
            "minLength": 1
          },
          "algorithm": {
            "const": "ed25519"
          },
          "public_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{43}=$"
          },
          "usages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "root_authority",
                "grant_issuer",
                "subject",
                "receipt_signer",
                "approval_signer",
                "execution_authorization_signer",
                "dispatch_witness_signer",
                "closure_signer"
              ]
            }
          }
        }
      }
    }
  }
}
