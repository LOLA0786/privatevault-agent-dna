{
  "version": "1.0",
  "policies": [
    {
      "id": "shell-destructive",
      "capability": "shell.exec",
      "outcome": "block",
      "reason": "destructive program in command (any wrapper or nesting)",
      "condition": {
        "field": "evidence.shell.executables",
        "operator": "any_in",
        "value": [
          "rm",
          "rmdir",
          "unlink",
          "dd",
          "shred",
          "mkfs",
          "mv",
          "chmod",
          "chown",
          "shutdown",
          "reboot",
          "truncate"
        ]
      }
    },
    {
      "id": "shell-destructive-flags",
      "capability": "shell.exec",
      "outcome": "block",
      "reason": "destructive operation (e.g. find -delete)",
      "condition": {
        "field": "evidence.shell.destructive",
        "operator": "==",
        "value": true
      }
    },
    {
      "id": "shell-allowlist",
      "capability": "shell.exec",
      "outcome": "block",
      "reason": "program not on the allowlist",
      "condition": {
        "field": "evidence.shell.executables",
        "operator": "any_not_in",
        "value": [
          "ls",
          "cat",
          "head",
          "tail",
          "grep",
          "find",
          "git",
          "pytest",
          "python",
          "uv",
          "curl",
          "wget",
          "wc",
          "sort",
          "uniq",
          "cut",
          "tr",
          "nl",
          "tac",
          "rev",
          "paste",
          "diff",
          "cmp",
          "comm",
          "column",
          "pwd",
          "which",
          "file",
          "stat",
          "du",
          "df",
          "basename",
          "dirname",
          "realpath",
          "date",
          "seq",
          "true",
          "false",
          "whoami",
          "uname"
        ]
      }
    },
    {
      "id": "shell-touches-privatevault",
      "capability": "shell.exec",
      "outcome": "block",
      "reason": "command names PrivateVault's own state (policy, grants, keys, ledger)",
      "condition": {
        "field": "arguments.touches",
        "operator": "any_in",
        "value": [
          "privatevault"
        ]
      }
    },
    {
      "id": "shell-touches-config",
      "capability": "shell.exec",
      "outcome": "require_approval",
      "reason": "command names Claude Code or git configuration, which can make later commands run code",
      "condition": {
        "field": "arguments.touches",
        "operator": "any_in",
        "value": [
          "claude-config",
          "git-internals"
        ]
      }
    },
    {
      "id": "shell-reads-credentials",
      "capability": "shell.exec",
      "outcome": "require_approval",
      "reason": "command reads credentials (a secret or credential file, or the environment)",
      "condition": {
        "field": "evidence.shell.touches_sensitive",
        "operator": "==",
        "value": true
      }
    },
    {
      "id": "shell-script-needs-approval",
      "capability": "shell.exec",
      "outcome": "require_approval",
      "reason": "interpreter runs a script file the guard cannot inspect",
      "condition": {
        "field": "evidence.shell.interpreter",
        "operator": "==",
        "value": true
      }
    },
    {
      "id": "shell-network-needs-approval",
      "capability": "shell.exec",
      "outcome": "require_approval",
      "reason": "network tool in command",
      "condition": {
        "field": "evidence.shell.network",
        "operator": "==",
        "value": true
      }
    },
    {
      "id": "fs-read-privatevault",
      "capability": "fs.read",
      "outcome": "block",
      "reason": "PrivateVault's state holds credentials kept from the agent",
      "condition": {
        "field": "arguments.zone",
        "operator": "==",
        "value": "privatevault"
      }
    },
    {
      "id": "fs-read-credentials",
      "capability": "fs.read",
      "outcome": "require_approval",
      "reason": "reads credentials",
      "condition": {
        "field": "arguments.zone",
        "operator": "==",
        "value": "credentials"
      }
    },
    {
      "id": "fs-write-privatevault",
      "capability": "fs.write",
      "outcome": "block",
      "reason": "PrivateVault's own policy, grants, keys and ledger are not the agent's to change",
      "condition": {
        "field": "arguments.zone",
        "operator": "==",
        "value": "privatevault"
      }
    },
    {
      "id": "fs-write-config",
      "capability": "fs.write",
      "outcome": "require_approval",
      "reason": "changes Claude Code or git configuration, which can make later commands run code",
      "condition": {
        "field": "arguments.zone",
        "operator": "in",
        "value": [
          "claude-config",
          "git-internals"
        ]
      }
    },
    {
      "id": "fs-write-credentials",
      "capability": "fs.write",
      "outcome": "require_approval",
      "reason": "writes a credential file",
      "condition": {
        "field": "arguments.zone",
        "operator": "==",
        "value": "credentials"
      }
    },
    {
      "id": "fs-write-outside-project",
      "capability": "fs.write",
      "outcome": "require_approval",
      "reason": "writes outside the project",
      "condition": {
        "field": "arguments.zone",
        "operator": "==",
        "value": "outside-project"
      }
    },
    {
      "id": "net-fetch-metadata",
      "capability": "net.fetch",
      "outcome": "block",
      "reason": "cloud metadata and link-local addresses hand out credentials",
      "condition": {
        "field": "arguments.host_class",
        "operator": "in",
        "value": [
          "metadata",
          "link-local",
          "invalid"
        ]
      }
    },
    {
      "id": "net-fetch-internal",
      "capability": "net.fetch",
      "outcome": "require_approval",
      "reason": "fetches from this machine or the internal network",
      "condition": {
        "field": "arguments.host_class",
        "operator": "in",
        "value": [
          "loopback",
          "private"
        ]
      }
    }
  ]
}
