# Copy to demos/live_checkout/.env (ignored by git). Only the agent reads it.
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-sonnet-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5
# Optional. Extra headers attached to every Anthropic request, as a JSON
# object, for organisations that route by a workspace header.
# ANTHROPIC_EXTRA_HEADERS={"anthropic-workspace-id": "wrkspc_..."}
# Optional. Thinking effort for the agent: low | medium | high. Default medium.
# PV_LIVE_EFFORT=medium
