# Copy to demos/live_checkout/.env (ignored by git). Only the agent reads it.
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-sonnet-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5
# Optional. Selects the Workspace for a credential that can act on more than
# one (sent by the SDK as the workspace header on every request).
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Optional. Any extra headers for every Anthropic request, as a JSON object.
# ANTHROPIC_EXTRA_HEADERS={"x-example": "value"}
# Optional. Thinking effort for the agent: low | medium | high. Default medium.
# PV_LIVE_EFFORT=medium
