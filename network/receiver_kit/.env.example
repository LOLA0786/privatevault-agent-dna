# Copy to .env and fill in. Never commit .env.

# Who this receiver is. Permits must name it as credential_audience.
PV_RECEIVER_ID=payments.partner.example

# Logical destination(s) a permit may name for this receiver, ';' separated.
# This is an identity string that must match the permit exactly. It is not
# the address the gate listens on (the demo listens on http://localhost:8080).
PV_RECEIVER_DESTINATIONS=https://payments.partner.example

# The issuing organisation and its permit-signing public key(s): key_id=BASE64;key_id=BASE64
# For the demo, paste the public key printed by: python -m network.receiver_kit.keygen issuer
PV_ISSUER_ORGANISATION=lender.example
PV_ISSUER_KEYS=ea-signer=PASTE_ISSUER_PUBLIC_KEY_HERE

# The partner's own receipt key id. The key itself is a file (see keygen.py).
PV_RECEIPT_KEY_ID=partner-receiver-01

# Optional. Both sides must use the same values; defaults are 1 and 2026-01-01T00:00:00Z.
# PV_TRUST_BUNDLE_VERSION=1
# PV_TRUST_BUNDLE_PINNED_AT=2026-01-01T00:00:00Z
